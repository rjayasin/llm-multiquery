{
  "manifest_version": 3,
  "name": "LLM Multiquery",
  "version": "1.0",
  "description": "Fan one prompt out to Claude, ChatGPT, and Gemini in three new tabs.",

  "permissions": ["tabs", "storage"],
  "host_permissions": [
    "https://gemini.google.com/*",
    "https://claude.ai/*",
    "https://chatgpt.com/*",
    "https://chat.openai.com/*"
  ],

  "omnibox": { "keyword": "llm" },

  "action": {
    "default_popup": "popup.html",
    "default_title": "Ask all 3 LLMs"
  },

  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Alt+L",
        "mac": "Command+Alt+L"
      },
      "description": "Open the multiquery popup"
    }
  },

  "background": {
    "scripts": ["background.js"]
  },

  "content_scripts": [
    {
      "matches": [
        "https://gemini.google.com/*",
        "https://claude.ai/*",
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": ["focus-spoof.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://gemini.google.com/*"],
      "js": ["gemini-content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://claude.ai/*",
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": ["autosubmit.js"],
      "run_at": "document_idle"
    }
  ],

  "browser_specific_settings": {
    "gecko": {
      "id": "llm-multiquery@local"
    }
  }
}
